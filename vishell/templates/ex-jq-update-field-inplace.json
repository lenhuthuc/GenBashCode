{
  "template_id": "ex-jq-update-field-inplace",
  "source": "original",
  "expected_action": "execute",
  "reversible": true,
  "params": {
    "key": {
      "choice": [
        "status",
        "stage"
      ]
    },
    "old_val": {
      "choice": [
        "draft",
        "pending"
      ]
    },
    "new_val": {
      "choice": [
        "done",
        "ready"
      ]
    }
  },
  "setup": "printf '{\"{key}\": \"{old_val}\"}' > data.json",
  "requests_vi": [
    "cập nhật trường {key} trong data.json thành '{new_val}'",
    "sửa data.json, đổi {key} thành '{new_val}'",
    "thay đổi giá trị {key} trong data.json sang '{new_val}'",
    "chỉnh data.json để {key} là '{new_val}'",
    "đổi {key} trong data.json từ '{old_val}' sang '{new_val}'",
    "dùng jq set .{key} = '{new_val}' và ghi đè data.json",
    "cập nhật data.json: {key} giờ là '{new_val}'",
    "set field {key} của data.json thành '{new_val}'",
    "trong data.json, {key} đang là '{old_val}', sửa lại thành '{new_val}'",
    "ghi đè giá trị {key} trong file data.json bằng '{new_val}'"
  ],
  "reference_command": "jq '.{key} = \"{new_val}\"' data.json > tmp.json && mv tmp.json data.json",
  "undo_command": "",
  "wrong_commands": [
    "true",
    "jq '.{key}' data.json"
  ],
  "check_type": "script",
  "check_expected": "[ \"$(jq -r .{key} data.json)\" = \"{new_val}\" ]"
}