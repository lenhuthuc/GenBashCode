{
  "template_id": "ex-tar-create",
  "source": "original",
  "expected_action": "execute",
  "reversible": true,
  "params": {
    "dirname": {
      "choice": [
        "project",
        "site"
      ]
    },
    "n": {
      "int": [
        1,
        4
      ]
    },
    "archive": {
      "choice": [
        "out.tar.gz",
        "pack.tar.gz"
      ]
    }
  },
  "setup": "mkdir {dirname}; for i in $(seq 1 {n}); do touch {dirname}/f_$i.txt; done",
  "requests_vi": [
    "nén thư mục {dirname} thành {archive}",
    "tạo file nén {archive} từ thư mục {dirname}",
    "đóng gói {dirname} thành {archive}",
    "nén giúp tôi {dirname} ra {archive}",
    "tar czf {archive} {dirname}",
    "đóng gói thư mục {dirname} thành file tar.gz tên {archive}",
    "backup {dirname} thành {archive}",
    "tạo archive {archive} từ {dirname}",
    "nén {dirname} bằng tar gzip, output {archive}",
    "làm file {archive} chứa toàn bộ {dirname}"
  ],
  "reference_command": "tar czf {archive} {dirname}",
  "undo_command": "rm -f {archive}",
  "wrong_commands": [
    "true",
    "touch {archive}"
  ],
  "check_type": "script",
  "check_expected": "[ -f {archive} ] && tar tzf {archive} >/dev/null 2>&1"
}