{
  "template_id": "pb-basename",
  "source": "original",
  "expected_action": "probe",
  "reversible": true,
  "params": {
    "dir": {
      "choice": [
        "home/user",
        "var/log"
      ]
    },
    "fname": {
      "choice": [
        "report.txt",
        "data.csv"
      ]
    },
    "n": {
      "int": [
        1,
        3
      ]
    }
  },
  "setup": "",
  "requests_vi": [
    "lấy tên file từ đường dẫn /{dir}/{fname}",
    "cho tôi tên file (không kèm thư mục) của /{dir}/{fname}",
    "trích xuất basename của /{dir}/{fname}",
    "đường dẫn /{dir}/{fname} thì tên file là gì?"
  ],
  "reference_command": "basename /{dir}/{fname}",
  "wrong_commands": [
    "true",
    "dirname /{dir}/{fname}"
  ],
  "check_type": "stdout_equals",
  "check_expected": "{fname}"
