# Minimal sandbox image for running one ViShell episode: python3 + the coreutils the
# templates are allowed to use. No network tools, no compilers beyond what's listed here.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    coreutils findutils grep sed gawk jq bc tree zip unzip file procps git \
    && rm -rf /var/lib/apt/lists/*

COPY vishell/sandbox/runner.py /vishell_runner.py

ENTRYPOINT ["python3", "/vishell_runner.py"]
